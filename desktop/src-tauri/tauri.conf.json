{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundLink",
  "version": "0.1.0",
  "identifier": "com.soundlink.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ./ui run dev",
    "beforeBuildCommand": "npm --prefix ./ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoundLink",
        "width": 510,
        "height": 780,
        "minWidth": 390,
        "minHeight": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "publisher": "SoundLink",
    "copyright": "Copyright © 2026 SoundLink",
    "category": "Music",
    "shortDescription": "局域网音频流转",
    "longDescription": "SoundLink 是面向头戴式耳机用户的局域网音频流转软件，支持手机音频通过局域网传输到电脑音频设备，以及电脑到电脑互传。",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "perMachine"
      },
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "signingIdentity": null,
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowPosition": { "x": 100, "y": 100 },
        "windowSize": { "width": 600, "height": 500 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 360, "y": 170 }
      }
    }
  }
}
