{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundLink",
  "version": "0.1.0",
  "identifier": "com.soundlink.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ./ui run dev",
    "beforeBuildCommand": "npm --prefix ./ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundLink",
        "width": 510,
        "height": 780,
        "minWidth": 390,
        "minHeight": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
