# ===========================================================================
# SoundLink · 根 .gitignore
# 覆盖：桌面(Rust/Tauri + Node/TS)、iOS(Xcode/Swift)、Android(Gradle/Kotlin)
# ===========================================================================

# ---------- 通用：操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 通用：编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~

# ---------- 通用：环境与密钥（禁止提交） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
secrets.*
credentials.*

# ---------- 桌面：Rust / Cargo / Tauri ----------
desktop/src-tauri/target/
target/
**/*.rs.bk
Cargo.lock            # 库场景可忽略；若作为可执行应用发布，可视需要取消忽略
desktop/src-tauri/gen/
desktop/src-tauri/WixTools/

# ---------- 桌面：Node / 前端 ----------
node_modules/
desktop/ui/dist/
desktop/ui/dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- iOS：Xcode / Swift ----------
mobile/ios/**/build/
mobile/ios/**/DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
# CocoaPods / SwiftPM
mobile/ios/**/Pods/
mobile/ios/**/.build/
Package.resolved

# ---------- Android：Gradle / Kotlin ----------
mobile/android/.gradle/
mobile/android/build/
mobile/android/**/build/
mobile/android/local.properties
mobile/android/.cxx/
*.apk
*.aab
*.ap_
*.dex
captures/

# ---------- 日志 / 临时 ----------
*.log
logs/
tmp/
*.tmp

# ---------- Python（工具脚本 / skills 缓存） ----------
__pycache__/
*.py[cod]
.venv/
venv/
