# ===========================================================================
# SoundLink · 根 .gitignore
# 覆盖：
# - 桌面端：Rust / Tauri / Node / TypeScript
# - Flutter App：Dart / Flutter / iOS / Android
# - 通用：系统文件 / IDE / 日志 / 临时文件 / 密钥
# ===========================================================================


# ===========================================================================
# 通用：操作系统文件
# ===========================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# ===========================================================================
# 通用：编辑器 / IDE
# ===========================================================================

.vscode/*
!.vscode/*.json
.vscode/settings.json
.vscode/*.local.json

.idea/
*.iml

*.swp
*.swo
*~


# ===========================================================================
# 通用：环境变量与密钥，禁止提交
# ===========================================================================

.env
.env.*
!.env.example

*.pem
*.key
*.keystore
*.jks
secrets.*
credentials.*

# MON-01 T1：license 签发私钥与台账绝不入库（test_sk.hex 为公开测试值，例外保留）
scripts/license/*.pem
*_sk*
!scripts/license/test_sk.hex
license_ledger.csv

# MON-01 Q5：发布 CI 检出私有 Pro 实现覆盖 desktop/pro/ 时的嵌套 git 目录（红线 G1/E7）
/desktop/pro/.git/


# ===========================================================================
# 通用：日志 / 临时目录
# ===========================================================================

*.log
logs/
tmp/
temp/
*.tmp


# ===========================================================================
# Python：工具脚本 / 缓存 / 虚拟环境
# ===========================================================================

__pycache__/
*.py[cod]
.venv/
venv/


# ===========================================================================
# 桌面端：Rust / Cargo / Tauri
# ===========================================================================

target/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/WixTools/

**/*.rs.bk

# 注意：
# 桌面端为可执行应用，Cargo.lock 应提交以锁定依赖版本。
# 所以这里不要忽略 Cargo.lock。


# ===========================================================================
# 桌面端：Node / 前端 / Vite
# ===========================================================================

node_modules/
desktop/ui/dist/
desktop/ui/dist-ssr/
.vite/
*.tsbuildinfo

*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/


# ===========================================================================
# SoundLink 调试音频转储文件
# ===========================================================================

soundlink_opus.bin
soundlink_pcm_decoded.raw
soundlink_pcm_resampled.raw
soundlink_sender_pcm.raw
soundlink_sender_opus.bin
soundlink_dump/

mobile/android/**/soundlink_dump/
mobile/flutter_app/**/soundlink_dump/


# ===========================================================================
# Flutter / Dart
# ===========================================================================

mobile/flutter_app/.dart_tool/
mobile/flutter_app/.packages
mobile/flutter_app/.flutter-plugins
mobile/flutter_app/.flutter-plugins-dependencies
mobile/flutter_app/pubspec.lock.tmp

mobile/flutter_app/build/
mobile/flutter_app/coverage/

# 如果未来有多个 Flutter 子项目，也可以匹配这些通用 Flutter 产物
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/


# ===========================================================================
# Flutter iOS / Xcode
# ===========================================================================

# Xcode 用户态文件
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.hmap

# Xcode 构建产物
*.ipa
*.dSYM.zip
*.dSYM

mobile/flutter_app/ios/**/build/
mobile/flutter_app/ios/**/DerivedData/

# Flutter iOS 生成文件
mobile/flutter_app/ios/Flutter/App.framework
mobile/flutter_app/ios/Flutter/Flutter.framework
mobile/flutter_app/ios/Flutter/Flutter.podspec
mobile/flutter_app/ios/Flutter/Generated.xcconfig
mobile/flutter_app/ios/Flutter/flutter_export_environment.sh
mobile/flutter_app/ios/Flutter/ephemeral/
mobile/flutter_app/ios/Flutter/app.flx
mobile/flutter_app/ios/Flutter/app.zip
mobile/flutter_app/ios/Flutter/flutter_assets/

mobile/flutter_app/ios/ServiceDefinitions.json

# CocoaPods
mobile/flutter_app/ios/Pods/
mobile/flutter_app/ios/.symlinks/

# 注意：
# 不要忽略以下文件，它们应该提交：
# mobile/flutter_app/ios/Podfile
# mobile/flutter_app/ios/Podfile.lock
# mobile/flutter_app/ios/Runner.xcworkspace/
# mobile/flutter_app/ios/Runner.xcodeproj/


# ===========================================================================
# Flutter Android / Gradle / Kotlin
# ===========================================================================

mobile/flutter_app/android/.gradle/
mobile/flutter_app/android/build/
mobile/flutter_app/android/**/build/
mobile/flutter_app/android/local.properties
mobile/flutter_app/android/.cxx/

*.apk
*.aab
*.ap_
*.dex
captures/


# ===========================================================================
# 原生移动端路径兼容：如果仓库里未来存在 mobile/ios 或 mobile/android
# ===========================================================================

mobile/ios/**/build/
mobile/ios/**/DerivedData/
mobile/ios/**/Pods/
mobile/ios/**/.build/
mobile/ios/**/opus-1.5.2/

mobile/android/.gradle/
mobile/android/build/
mobile/android/**/build/
mobile/android/local.properties
mobile/android/.cxx/


# ===========================================================================
# Swift Package Manager
# ===========================================================================

.build/
Package.resolved


# ===========================================================================
# 当前不应提交的误生成平台目录
# ===========================================================================
# 你当前 git status 中出现了：
# ?? mobile/flutter_app/macos/
#
# 如果这个项目暂时不支持 Flutter macOS，可以保留下面这一行。
# 如果未来要支持 macOS，请删除这一行，并把 macos/ 作为正式平台代码提交。
mobile/flutter_app/macos/